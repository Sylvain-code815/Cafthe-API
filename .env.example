# URL(s) du front autorisées par CORS, séparées par une virgule
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Config du serveur
PORT=3000
HOST=localhost
# development | production
NODE_ENV=development

# Config bdd (utilisateur dédié créé par database/create_user.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=cafthe_api
DB_PASSWORD=
DB_NAME=cafthe

# configuration de bcryptJS (coût du hachage)
BCRYPT_ROUNDS=10

# configuration jwt : clé longue et aléatoire
JWT_SECRET=
# durée de session client en secondes
JWT_EXPIRES_IN=3600

# Emails (mot de passe oublié, confirmation de commande)
# log, sendmail ou smtp
MAIL_TRANSPORT=log
MAIL_FROM=CafThé <no-reply@slaurent.dev-campus.fr>
# Page du front qui reçoit le lien
RESET_PASSWORD_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
