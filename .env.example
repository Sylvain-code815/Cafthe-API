# Modèle du fichier .env : copier ce fichier en .env puis remplir les valeurs
# (le vrai .env n'est jamais versionné, voir .gitignore)

# URL(s) du front autorisées par CORS, séparées par une virgule
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Config du serveur
PORT=3000
HOST=localhost
# development | production (production = cookie "Secure" : HTTPS obligatoire)
NODE_ENV=development

# Config bdd (utilisateur dédié créé par database/create_user.sql)
# Avec WAMP : MariaDB écoute sur 3307, MySQL sur 3306
DB_HOST=localhost
DB_PORT=3306
DB_USER=cafthe_api
DB_PASSWORD=
DB_NAME=cafthe

# configuration de bcryptJS (coût du hachage)
BCRYPT_ROUNDS=10

# configuration jwt : clé longue et aléatoire, générée avec
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# durée de session client en secondes (le personnel est fixé à 30 minutes)
JWT_EXPIRES_IN=3600

# Emails (mot de passe oublié, confirmation de commande)
# log = affiché dans la console (développement) ; sendmail = serveur Plesk ; smtp = SMTP_HOST...
MAIL_TRANSPORT=log
MAIL_FROM=CafThé <no-reply@slaurent.dev-campus.fr>
# Page du front qui reçoit le lien (par défaut : première URL de FRONTEND_URL + /#/reset-password)
RESET_PASSWORD_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
